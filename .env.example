# MindTrainer Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Database
# ============================================
DATABASE_URL=jdbc:postgresql://localhost:5432/mindtrainer
DATABASE_USERNAME=mindtrainer
DATABASE_PASSWORD=mindtrainer

# ============================================
# Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# JWT
# ============================================
JWT_SECRET=your-256-bit-secret-key-here-min-32-chars-long-for-security
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ============================================
# OAuth2 Providers
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# Email (for verification, password reset)
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ============================================
# CORS
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:3000

# ============================================
# Server
# ============================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ============================================
# Web App (Next.js)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# ============================================
# Analytics (Optional)
# ============================================
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://app.posthog.com